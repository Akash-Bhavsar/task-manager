# Server environment variables. Copy to `.env` and fill in real values.

# PostgreSQL connection string used by Prisma.
# Local example: postgresql://USER:PASSWORD@localhost:5432/taskmanager
# Neon example:  postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Secret used to sign/verify JWTs. Use a long random string.
JWT_SECRET=

# Port the API listens on. Must differ from the client dev server (3000).
PORT=4000

# development | production
env_type=development


# For production system
CLIENT_ORIGIN=http://localhost:3000,https://task-manager-******.vercel.app
CLIENT_ORIGIN_REGEX=^https://task-manager-[a-z0-9-]+\.vercel\.app$
