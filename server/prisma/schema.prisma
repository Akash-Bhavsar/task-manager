// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  ADMIN
  USER
  // Add additional roles here if needed
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  role     Role    @default(USER)
  tasks    Task[]
  labels   Label[]
}

// User-scoped tag. Many-to-many with Task (implicit join table _LabelToTask).
model Label {
  id     Int    @id @default(autoincrement())
  name   String
  color  String @default("#64748b")
  user   User   @relation(fields: [userId], references: [id])
  userId Int
  tasks  Task[]

  // A user can't have two labels with the same name.
  @@unique([userId, name])
  @@index([userId])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  // Canonical values enforced at the app layer (see utils/taskConstants).
  // Kept as String (not a DB enum) until the repo adopts real Prisma migrations.
  status      String    @default("draft")
  priority    String    @default("medium")
  dueDate     DateTime?
  // Ordering within a status column (Kanban). Lower = higher in the list.
  // Float so a moved card can take the midpoint between its two neighbors —
  // a single-row write, no whole-column reindex.
  position    Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  labels      Label[]

  @@index([userId, status])
}
